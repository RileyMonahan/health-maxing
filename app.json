{
  "expo": {
    "name": "Health Maxing",
    "slug": "health-maxing",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.healthmaxing.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EAF5FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.healthmaxing.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Health Maxing uses your photos so you can add progress photos."
        }
      ]
    ],
    "scheme": "healthmaxing",
    "experiments": {
      "typedRoutes": false
    }
  }
}
